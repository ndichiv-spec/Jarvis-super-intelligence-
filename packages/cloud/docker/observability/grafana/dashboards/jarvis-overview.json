{
  "title": "JARVIS Platform Overview",
  "uid": "jarvis-overview",
  "version": 1,
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Service Health",
      "type": "stat",
      "gridPos": {"h": 8, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=~\"jarvis-.*\"}", "legendFormat": "{{job}}"}]
    },
    {
      "title": "HTTP Request Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 4, "y": 0},
      "targets": [{"expr": "rate(http_requests_total[5m])", "legendFormat": "{{job}}"}]
    },
    {
      "title": "Request Duration (p99)",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 8, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))"}]
    },
    {
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 4, "x": 0, "y": 8},
      "targets": [{"expr": "process_resident_memory_bytes", "legendFormat": "{{job}}"}]
    },
    {
      "title": "CPU Usage",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 4, "x": 4, "y": 8},
      "targets": [{"expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "{{job}}"}]
    },
    {
      "title": "AI Request Duration",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [{"expr": "rate(ai_request_duration_seconds_sum[5m]) / rate(ai_request_duration_seconds_count[5m])", "legendFormat": "{{provider}}"}]
    },
    {
      "title": "Workflow Runs",
      "type": "bar-gauge",
      "gridPos": {"h": 8, "w": 4, "x": 0, "y": 16},
      "targets": [{"expr": "increase(workflow_runs_total[24h])", "legendFormat": "{{status}}"}]
    },
    {
      "title": "Queue Depth",
      "type": "graph",
      "gridPos": {"h": 8, "w": 8, "x": 4, "y": 16},
      "targets": [{"expr": "queue_depth", "legendFormat": "{{queue}}"}]
    }
  ]
}
