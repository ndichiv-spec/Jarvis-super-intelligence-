{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/tauri-v2.0.0/tooling/cli/schema.json",
  "productName": "JARVIS Desktop Intelligence",
  "version": "1.0.0",
  "identifier": "com.jarvis.desktop-intelligence",
  "build": {
    "frontendDist": "../.next",
    "devUrl": "http://localhost:5432",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "JARVIS Desktop Intelligence",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": {
      "all": true
    },
    "clipboard-manager": {
      "all": true
    },
    "fs": {
      "all": true
    },
    "updater": {
      "active": true,
      "endpoints": ["https://releases.jarvis.ai/desktop/{{target}}/{{current_version}}"],
      "dialog": true,
      "pubkey": "jarvis-desktop-intelligence-update-key"
    }
  }
}
